# Copy to .env (never commit .env)
# local = free models (Ollama + Cloudflare) | prod = official Meta models | mock = no network
MODE=local

# --- Official Meta Model API (prod) ---
META_API_KEY=
META_CHAT_MODEL=muse-spark-1.3
# Cheaper tier, Meta may train on prompts: muse-spark-1.3-contributor

# --- Muse Spark Open on Baseten (prod backup + open-weight bonus) ---
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- Cloudflare Workers AI (free, local backup) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Optional extra voters for LOCAL mode only (production uses Meta models) ---
# Groq retired its Llama 4 models in July 2026; its current image model is Qwen.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Ollama on your laptop (free, offline) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Free models that read images in local mode. All of them vote on room names; the first is preferred.
# Add groq and/or gemini here once their keys are set. Keys left empty are skipped.
LOCAL_VISION_CHAIN=cloudflare,ollama,gemini,groq

# Save AI answers so repeat runs are free. Set to false while tuning prompts.
AI_CACHE=true

FRONTEND_ORIGIN=http://localhost:5173
